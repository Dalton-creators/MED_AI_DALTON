{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "med-ai-dalton",
  "main": "src/index.js",
  "compatibility_date": "2026-08-29",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "med_ai_dalton_db",
      "database_id": "e0da0c4a-c7ca-4eab-9061-f4e9d34ad890"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "vars": {
    "CLOUDFLARE_AI_MODEL": "@cf/zai-org/glm-4.7-flash",
    "CLOUDFLARE_VISION_MODEL": "@cf/google/gemma-4-26b-a4b-it",
    "ALLOW_SIGNUPS": "false",
    "ENVIRONMENT": "production"
  },
  "observability": {
    "enabled": true
  }
}
