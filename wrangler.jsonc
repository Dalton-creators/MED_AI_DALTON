{
  "name": "med-ai-dalton",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "keep_vars": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ],
    "not_found_handling": "single-page-application"
  },
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "med_ai_dalton_db",
      "database_id": "e0da0c4a-c7ca-4eab-9061-f4e9d34ad890"
    }
  ],
  "r2_buckets": [
    {
      "binding": "LIBRARY",
      "bucket_name": "med-ai-dalton-library"
    }
  ],
  "vars": {
    "ALLOW_SIGNUPS": "false",
    "CLOUDFLARE_AI_MODEL": "@cf/zai-org/glm-4.7-flash",
    "CLOUDFLARE_VISION_MODEL": "@cf/google/gemma-4-26b-a4b-it",
    "ENVIRONMENT": "production"
  }
}